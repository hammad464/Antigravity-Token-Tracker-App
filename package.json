{
  "name": "antigravity-token-tracker",
  "version": "1.0.0",
  "description": "Antigravity Model Quotas & Token Monitor Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "portable": "electron-builder --win portable",
    "pack": "electron-builder --win dir"
  },
  "keywords": [
    "antigravity",
    "tokens",
    "quotas",
    "gemini",
    "claude",
    "desktop-app"
  ],
  "author": "Antigravity User",
  "license": "MIT",
  "build": {
    "appId": "com.antigravity.token-tracker",
    "productName": "Antigravity Quotas & Token Monitor",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
